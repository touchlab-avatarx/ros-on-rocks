{
  // Container setup
  "name": "ros2",  // Name of the devcontainer - change this if you are running multiple containers in the same workspace
  "remoteUser": "user",  // This has to match the user in the Dockerfile
  "initializeCommand": ".devcontainer/build-devcontainer.sh",
  "runArgs": [
        "--env-file", ".env"  // Edit the .env file to change the ROS2 distribution and domain ID after setup
    ],
  "dockerComposeFile": ["dev.yml"],
  "runServices": ["dev"],
  "service": "dev",
  "shutdownAction": "none", // Don't stop the container when closing the workspace, useful for remote editing and debugging
  "workspaceFolder": "/ros2",
  // Settings for VS Code
  "customizations": {
    "vscode": {
      "settings": {
        // Linting and formatting (matches ROS 2 style guides)
        "cpplint.cpplintPath": "/usr/bin/ament_cpplint",
        "[python]": {
          "editor.defaultFormatter": "ms-python.autopep8"
        },
        "python.formatting.provider": "black",
        "python.envFile": "${workspaceFolder}/.vscode/colcon.env",
        "python.analysis.autoSearchPaths": true,
        "cSpell.language": "en-GB",
        "C_Cpp.dimInactiveRegions": false,
        "editor.tabSize": 2,
        "editor.rulers": [
          100
        ],
        "search.exclude": {
          "**/build": true,
          "**/install": true,
          "**/log": true
        },
        // Git settings
        "git.autorefresh": true,
        "git-graph.maxDepthOfRepoSearch": 10,
        "git.autoRepositoryDetection": "subFolders",
        "git.repositoryScanMaxDepth": 10,
        "git.scanRepositories": [
          "src/*"  // Scan for git repositories in the src folder
        ],
        "colcon.provideTasks": true,
      },
      // Extensions to install in the devcontainer
      // Customise this list to add/remove extensions as needed
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-iot.vscode-ros",
        "smilerobotics.urdf",
        "ms-python.python",
        "ms-python.autopep8",
        "ms-python.black-formatter",
        "njpwerner.autodocstring",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh",
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "mhutchie.git-graph",
        "shardulm94.trailing-spaces",
        "xaver.clang-format",
        "mine.cpplint",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "lextudio.restructuredtext",
        "trond-snekvik.simple-rst",
        "deitry.colcon-helper",
        "spencerwmiles.vscode-task-buttons",
        "slevesque.vscode-3dviewer",
        "matepek.vscode-catch2-test-adapter",
        "msfukui.eof-mark",
        "nonanonno.vscode-ros2",
        "GitHub.copilot",
        "anthropic.claude-code",
      ]
    }
  }
}